# 时光迹本地开发环境示例 — 复制为 backend/.env 后填写
# 严禁把真实密码提交到版本库

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=shiguangji

JWT_SECRET=please-use-a-long-random-string
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# 可追加生产域名，逗号分隔时用环境变量覆盖（代码读 allowed_origins）
# 例如部署到 https://moments.example.com 时：
# COOKIE_SECURE=true
# FRONTEND_ORIGIN=https://moments.example.com

# 媒体限制（可按需下调）
MAX_PHOTO_BYTES=10485760
MAX_VIDEO_BYTES=104857600
MAX_VIDEO_SECONDS=180
