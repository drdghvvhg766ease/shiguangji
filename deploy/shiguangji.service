# 时光迹 systemd 单元示例（Linux 云主机）
# /etc/systemd/system/shiguangji.service

[Unit]
Description=Shiguangji FastAPI
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/shiguangji/backend
EnvironmentFile=/opt/shiguangji/backend/.env
ExecStart=/opt/shiguangji/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
